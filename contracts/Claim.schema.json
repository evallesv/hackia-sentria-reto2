{
  "$defs": {
    "ClaimStatus": {
      "enum": [
        "DRAFT",
        "READY_FOR_EXTRACTION",
        "AUDITED"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "DocumentKind": {
      "enum": [
        "INCIDENT_REPORT",
        "WORKSHOP_REPORT",
        "BILLING_DOCUMENT",
        "TARIFF"
      ],
      "title": "DocumentKind",
      "type": "string"
    },
    "StoredDocument": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DocumentKind"
        },
        "mime": {
          "pattern": "^(application/pdf|application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet)$",
          "title": "Mime",
          "type": "string"
        },
        "byte_count": {
          "exclusiveMinimum": 0,
          "maximum": 10485760,
          "title": "Byte Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "filename": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "claim_id",
        "kind",
        "mime",
        "byte_count",
        "sha256",
        "filename",
        "version"
      ],
      "title": "StoredDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ClaimStatus",
      "default": "DRAFT"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/StoredDocument"
      },
      "title": "Documents",
      "type": "array"
    }
  },
  "required": [
    "id",
    "created_at"
  ],
  "title": "Claim",
  "type": "object"
}
