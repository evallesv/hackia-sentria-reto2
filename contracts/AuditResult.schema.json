{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Document Id",
          "type": "string"
        },
        "location": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "document_id",
        "location",
        "text"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "financial_impact": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,18}|(?=[\\d.]{1,21}0*$)\\d{0,18}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Financial Impact"
        },
        "calculation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Status": {
      "enum": [
        "CANDIDATE_FOR_APPROVAL",
        "REVIEW_REQUIRED",
        "INFORMATION_REQUIRED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "currency": {
      "const": "USD",
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "billed_amount": {
      "anyOf": [
        {
          "decimal_places": 2,
          "ge": 0,
          "max_digits": 12,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Billed Amount"
    },
    "flagged_difference": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,18}|(?=[\\d.]{1,21}0*$)\\d{0,18}\\.\\d{0,2}0*$)",
          "type": "string"
        }
      ],
      "title": "Flagged Difference"
    },
    "reference_subtotal": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,18}|(?=[\\d.]{1,21}0*$)\\d{0,18}\\.\\d{0,2}0*$)",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reference Subtotal"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "mode": {
      "enum": [
        "mock",
        "gemini"
      ],
      "title": "Mode",
      "type": "string"
    },
    "trace": {
      "items": {
        "type": "string"
      },
      "title": "Trace",
      "type": "array"
    },
    "rule_version": {
      "default": "rules-v1",
      "title": "Rule Version",
      "type": "string"
    },
    "prompt_version": {
      "default": "consistency-v1",
      "title": "Prompt Version",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "input_tokens": {
      "default": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "default": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "duration_ms": {
      "default": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "input_sha256": {
      "default": "",
      "title": "Input Sha256",
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "status",
    "billed_amount",
    "flagged_difference",
    "reference_subtotal",
    "findings",
    "evidence",
    "mode",
    "trace"
  ],
  "title": "AuditResult",
  "type": "object"
}
