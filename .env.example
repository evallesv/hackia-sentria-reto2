# Demo reproducible. No requiere claves ni realiza llamadas externas.
AI_MODE=mock
# Solo se utiliza al elegir AI_MODE=gemini. No inventar un modelo disponible.
GEMINI_API_KEY=
GEMINI_MODEL=
# API JSON personalizada solo para trabajo local. Mantener false en demo pública.
ENABLE_CUSTOM_INPUT=false
MAX_REQUEST_BYTES=262144
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_CALLS_PER_PROCESS=20

# Configuración impositiva por país (por defecto Panamá ITBMS 7%; ej. IVA 16% en México: TAX_RATE=0.16)
TAX_NAME=ITBMS
TAX_RATE=0.07
